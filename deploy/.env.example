# ---- required -----------------------------------------------------------------------------------------
# Public host name (or IP for testing). Must resolve to this server for Let's Encrypt.
DOMAIN=nis2.example.com
# Certificate source:
#   TLS_ISSUER=default  + TLS_MODE=internal       -> self-signed certificate from Caddy's local CA (testing)
#   TLS_ISSUER=default  + TLS_MODE=<your e-mail>  -> Let's Encrypt (production, public DNS name)
#   TLS_ISSUER=acme                               -> your internal ACME CA (step-ca, Smallstep, EJBCA, Vault PKI, ...)
#   TLS_ISSUER=acme_eab                           -> internal ACME CA that requires External Account Binding;
#                                                    put ACME_EAB_KID and ACME_EAB_HMAC into deploy/caddy.env
TLS_ISSUER=default
TLS_MODE=internal
# Internal ACME CA only: directory URL, optional account e-mail, root certificate in deploy/certs/.
# The root certificate is used to trust the ACME server; every *.pem/*.crt in deploy/certs/ is also trusted by the
# app for outgoing connections (OIDC issuer, AI endpoint, SMTP).
#ACME_CA_URL=https://ca.example.internal/acme/acme/directory
#ACME_EMAIL=pki-admin@example.com
#ACME_CA_ROOT=acme-ca-root.pem
POSTGRES_PASSWORD=change-me-long-random
# App image. Default: built locally with `docker compose up -d --build`. Prebuilt by CI instead:
#APP_IMAGE=ghcr.io/techmhe/nis2-compass:1.0.1
# Docker network between proxy and app. Only change if the subnet collides with your networks; PROXY_IP must lie
# inside INTERNAL_SUBNET. The app trusts X-Forwarded-For only from PROXY_IP.
#INTERNAL_SUBNET=172.30.64.0/24
#PROXY_IP=172.30.64.10
# At least 32 random characters, e.g. `openssl rand -base64 48`. Encrypts the AI API key and signs tokens.
NIS2_SECRET_KEY=change-me-at-least-32-random-characters

# ---- optional -----------------------------------------------------------------------------------------
NIS2_APP_NAME=NIS2 Compass
# Load demo users and demo data (never in production)
NIS2_LOAD_DEMO_DATA=false
NIS2_WORKERS=2
NIS2_MAX_UPLOAD_MB=50

# Local accounts (disable once SSO works, keep one break-glass admin if you like)
NIS2_LOCAL_AUTH_ENABLED=true

# OpenID Connect (Entra ID, Keycloak, Authentik, Okta, ...). Redirect URI: https://<DOMAIN>/api/auth/oidc/callback
NIS2_OIDC_ENABLED=false
NIS2_OIDC_DISPLAY_NAME=Company account
NIS2_OIDC_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
NIS2_OIDC_CLIENT_ID=
NIS2_OIDC_CLIENT_SECRET=
NIS2_OIDC_SCOPES=openid email profile
NIS2_OIDC_GROUPS_CLAIM=groups
# JSON: IdP group -> role key (admin, security_officer, project_manager, assessor, contributor, viewer, auditor);
# append @ENTITYCODE to scope a role to one legal entity, e.g. {"nis2-nl-contacts":"contributor@ATN"}
NIS2_OIDC_ROLE_MAPPING={}
NIS2_OIDC_DEFAULT_ROLE=viewer
NIS2_OIDC_AUTO_PROVISION=true
# Only if your IdP guarantees e-mail ownership but omits email_verified (e.g. Entra ID):
NIS2_OIDC_TRUST_EMAIL=false

# AI assistant defaults (can also be set in Administration -> AI assistant)
NIS2_AI_BASE_URL=
NIS2_AI_API_KEY=
NIS2_AI_CHAT_MODEL=
NIS2_AI_EMBEDDING_MODEL=

# E-mail notifications
NIS2_SMTP_HOST=
NIS2_SMTP_PORT=587
NIS2_SMTP_USER=
NIS2_SMTP_PASSWORD=
NIS2_SMTP_FROM=
NIS2_SMTP_STARTTLS=true
