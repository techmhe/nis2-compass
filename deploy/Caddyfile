# Reverse proxy with automatic HTTPS. The certificate source is chosen with TLS_ISSUER (see deploy/.env.example):
#   TLS_ISSUER=default,    TLS_MODE=internal        -> Caddy's local CA, self-signed (testing)
#   TLS_ISSUER=default,    TLS_MODE=<your e-mail>   -> Let's Encrypt (public ACME)
#   TLS_ISSUER=acme                                 -> your own ACME CA (ACME_CA_URL), trusted via certs/acme-ca-root.pem
#   TLS_ISSUER=acme_eab                             -> as "acme", with External Account Binding (caddy.env)
{
	servers {
		trusted_proxies static private_ranges
	}
}

(tls_default) {
	tls {$TLS_MODE}
}

(tls_acme) {
	tls {$ACME_EMAIL} {
		ca {$ACME_CA_URL}
		ca_root /etc/caddy/certs/{$ACME_CA_ROOT:acme-ca-root.pem}
	}
}

(tls_acme_eab) {
	tls {$ACME_EMAIL} {
		ca {$ACME_CA_URL}
		ca_root /etc/caddy/certs/{$ACME_CA_ROOT:acme-ca-root.pem}
		eab {$ACME_EAB_KID} {$ACME_EAB_HMAC}
	}
}

{$DOMAIN} {
	import tls_{$TLS_ISSUER:default}
	encode zstd gzip

	request_body {
		max_size {$MAX_BODY:60MB}
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
		-Via
	}

	reverse_proxy app:8000 {
		# server-sent events (AI assistant) must not be buffered
		flush_interval -1
		header_up X-Forwarded-Proto {scheme}
	}

	log {
		output stdout
		format console
	}
}
