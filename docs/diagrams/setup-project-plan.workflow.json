  "cards": [
    {
      "dot": "emerald",
      "title": "Server computes",
      "items": [
        "The wizard never calculates dates itself",
        "Preview and setup use the same schedule()",
        "Template order and dependencies stay fixed"
      ]
    },
    {
      "dot": "rose",
      "title": "Tight end date",
      "items": [
        "The plan is fitted to the end date both ways",
        "Below 75% of the proposed time a warning shows",
        "Setup still accepts the compressed plan"
      ]
    },
    {
      "dot": "cyan",
      "title": "Roles",
      "items": [
        "Dropped roles become inactive stakeholders",
        "Their items fall back to the Information Security Officer",
        "Every RACI row keeps exactly one accountable"
      ]
    }
  ]
