#!/usr/bin/env bash
# Copy to .claude/smoke.sh and list the URLs to check (scripts/dev.sh must be running).
# Each line: <expected HTTP status> <URL>. Silent on success.
set -uo pipefail

checks=(
  "200 http://localhost:8000/api/health"
  "200 http://localhost:5173/"
)

fail=0
for c in "${checks[@]}"; do
  want=${c%% *}; url=${c#* }
  got=$(curl -s -o /dev/null -m 10 -w '%{http_code}' "$url") || got="000"
  if [ "$got" != "$want" ]; then
    echo "smoke: $url returned $got, expected $want"
    fail=1
  fi
done
exit "$fail"
