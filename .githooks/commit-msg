#!/usr/bin/env bash
# Enforce Conventional Commits on the subject line.
set -u
subject=$(head -n 1 "$1")
case "$subject" in "Merge "*|"Revert "*|"fixup! "*|"squash! "*) exit 0 ;; esac
if ! grep -Eq '^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9._/-]+\))?!?: .+' <<<"$subject"; then
  echo "commit-msg: not a Conventional Commit: $subject" >&2
  echo "  expected: <type>(<scope>)?: <summary>, type one of feat fix docs style refactor perf test build ci chore revert" >&2
  exit 1
fi
exit 0
